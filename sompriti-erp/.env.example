# Copy these into Railway > your app service > Variables (do not commit real values)

# Railway PostgreSQL: reference the database service variable
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Security: generate a long random value, e.g. `openssl rand -base64 48`
Jwt__SigningKey=
Jwt__AccessTokenMinutes=15

# First administrator (created on first start only when no ADMIN exists)
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=ChangeMe123
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_PHONE=01700000000

# Public URL of the app (used in password reset emails)
App__PublicBaseUrl=https://your-app.up.railway.app
App__BusinessName=Sompriti Enterprise

# SMS (Bangladesh). Provider: Log | BulkSmsBd | GenericHttp
Sms__Enabled=false
Sms__Provider=BulkSmsBd
Sms__ApiUrl=https://bulksmsbd.net/api/smsapi
Sms__ApiKey=
Sms__SenderId=
# GenericHttp example (any gateway with an HTTP API):
# Sms__UrlTemplate=https://gateway.example.com/send?key={apiKey}&to={number}&from={senderId}&text={message}
# Sms__Method=GET
# Sms__SuccessContains=success

# Email for password reset. Provider: Log | Brevo | Resend
Email__Provider=Brevo
Email__ApiKey=
Email__FromAddress=no-reply@yourdomain.com
Email__FromName=Sompriti ERP
